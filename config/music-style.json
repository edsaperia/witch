  "sections": {
    "intro": {"feel": "The home speakers boot up: a pad, then plucks, a shaker, the sub and a soft kick as they power on.", "progression": "forest", "chordBars": 2, "cutoff": [600, 9000], "ending": "none", "parts": {"pad": "hold", "pluck": {"p": "sparse", "from": 0.2, "level": 0.8}, "shaker": {"p": "eighth", "from": 0.45, "level": 0.6}, "sub": {"p": "long", "from": 0.6, "level": 0.6}, "softkick": {"p": "soft", "from": 0.8, "level": 0.7}, "choir": {"p": "hold", "from": 0.1, "level": 0.7}}},
    "forest": {"feel": "Gentle and mysterious: a heartbeat kick, marimba, shaker, warm pad.", "progression": "forest", "chordBars": 2, "cutoff": 7000, "ending": "none", "parts": {"pad": {"p": "hold", "level": 0.6}, "pluck": "flow", "shaker": {"p": "eighth", "level": 0.7}, "softkick": {"p": "heart", "level": 0.7}, "sub": {"p": "roots", "level": 0.6}, "choir": {"p": "hold", "level": 0.7}}},
    "forestBeat": {"feel": "The forest finds a pulse: four soft kicks and an offbeat hat.", "base": "forest", "cutoff": 9000, "parts": {"softkick": {"p": "four", "level": 0.75}, "hat": {"p": "off", "level": 0.5}}},
    "whisper": {"feel": "A minimal, dark breakdown: finger snaps over a long sub.", "progression": "home", "chordBars": 2, "cutoff": 2600, "ending": "none", "parts": {"pad": {"p": "hold", "level": 0.6}, "sub": "long", "snap": "lazy", "pluck": {"p": "sparse", "level": 0.7}, "vox": {"p": "sparse", "level": 0.6}}},
