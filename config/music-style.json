    "deep": {"feel": "Deep melodic house: four on the floor, rolling offbeat bass, plucks, pumping chords.", "progression": "home", "chordBars": 2, "sevenths": true, "cutoff": 14000, "parts": {"kick": "four", "hat": "off", "shaker": {"p": "sixteen", "level": 0.5, "energy": 0.3}, "clap": {"p": "back", "level": 0.8, "energy": 0.4}, "bass": "roll", "pad": {"p": "pump", "level": 0.8}, "pluck": "flow", "vox": {"p": "sparse", "level": 0.6, "energy": 0.35}}},
