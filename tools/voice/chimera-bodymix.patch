diff --git a/crates/chimera-cli/src/main.rs b/crates/chimera-cli/src/main.rs
index cbf1b9b..9e22416 100644
--- a/crates/chimera-cli/src/main.rs
+++ b/crates/chimera-cli/src/main.rs
@@ -59,7 +59,8 @@ pub fn body(name: &str) -> Result<HumanBody, String> {
         "male" => Ok(BODY_MALE),
         "female" => Ok(BODY_FEMALE),
         "child" => Ok(BODY_CHILD),
-        _ => Err(format!("unknown body {name:?}; have male, female, child")),
+        _ if name.starts_with("mix:") => Ok(body_mix(name)?.body()),
+        _ => Err(format!("unknown body {name:?}; have male, female, child, mix:<female 0..1>,<child 0..1>")),
     }
 }
 
@@ -69,7 +70,12 @@ pub fn body_mix(name: &str) -> Result<BodyMix, String> {
         "male" => Ok(BodyMix::new(0.0, 0.0)),
         "female" => Ok(BodyMix::new(1.0, 0.0)),
         "child" => Ok(BodyMix::new(0.0, 1.0)),
-        _ => Err(format!("unknown body {name:?}; have male, female, child")),
+        // a blend of the presets, as the app's body sliders: `mix:1,0.5` is half way from female to child
+        _ if name.starts_with("mix:") => {
+            let v: Vec<f64> = name[4..].split(',').filter_map(|x| x.trim().parse().ok()).collect();
+            if v.len() == 2 { Ok(BodyMix::new(v[0], v[1])) } else { Err(format!("body {name:?}: mix:<female 0..1>,<child 0..1>")) }
+        }
+        _ => Err(format!("unknown body {name:?}; have male, female, child, mix:<female 0..1>,<child 0..1>")),
     }
 }
 
